# Public DNS name used by Caddy.
GATEWAY_PUBLIC_DOMAIN=ln-gateway-utexo.utexo.com

# Gateway bind address inside container.
WASM_PROXY_LISTEN_ADDR=0.0.0.0:3001

# RGB upstream (internal URL preferred).
WASM_PROXY_RGB_UPSTREAM=http://rgb-proxy.internal:3000/json-rpc

# Browser origins allowed by gateway CORS.
WASM_PROXY_CORS_ALLOW_ORIGINS=https://app.utexo.com,https://signet.utexo.com

# Production relay auth: required for ws relay endpoint.
WASM_PROXY_RELAY_AUTH_REQUIRED=true
WASM_PROXY_RELAY_AUTH_TOKEN=REPLACE_ME_SECURE_RANDOM_TOKEN
WASM_PROXY_RELAY_NODE_ID=REPLACE_ME_NODE_ID

# Signet peers are public, so this must be enabled.
WASM_PROXY_ALLOW_PUBLIC_TARGETS=true

# Optional hard allowlist (comma-separated, lowercase).
# WASM_PROXY_TARGET_ALLOWLIST=localhost,127.0.0.1,::1,signet-ln-peer1.utexo.com
WASM_PROXY_TARGET_ALLOWLIST=localhost,127.0.0.1,::1

# Runtime limits.
WASM_PROXY_RGB_MAX_BODY_BYTES=2097152
WASM_PROXY_RGB_REQUEST_TIMEOUT_MS=15000
WASM_PROXY_TCP_CONNECT_TIMEOUT_MS=5000
WASM_PROXY_IO_IDLE_TIMEOUT_MS=60000
WASM_PROXY_WS_MAX_FRAME_BYTES=131072
WASM_PROXY_WS_MAX_MESSAGE_BYTES=262144
WASM_PROXY_TCP_READ_CHUNK_BYTES=8192
WASM_PROXY_MAX_ACTIVE_WS=512
WASM_PROXY_MAX_ACTIVE_WS_PER_IP=64

# Replay buffer controls.
WASM_PROXY_REPLAY_MAX_FRAMES=1024
WASM_PROXY_REPLAY_TTL_SECS=300
WASM_PROXY_REPLAY_MAX_SESSIONS=256
